{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=mydatabase;Username=myuser;Password=mypassword;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.Hosting": "Information",
      "Stayza.Web.Infrastructure.Middleware.LoggingMiddleware": "Information"
    }
  },
  "AllowedHosts": "*",
  "Notifications": {
    "URL_WHEN_RUN_IN_DOCKER_COMPOSE": "http://notifications_api",
    "BaseUrl": "http://localhost:1000"
  },
  "TickerQBasicAuth": {
    "Username": "admin",
    "Password": "admin"
  },
  "RabbitMQSettings": {
    "HostName": "localhost",
    "ExchangeName": "notifications_exchange",
    "ExchangeType": "topic",
    "UserName": "guest1",
    "Password": "guest1",
    "ConnectionString": "amqp://guest1:guest1@localhost:5672/"
  },
  "OpenTelemetrySettings": {
    "Enabled": true,
    "TracesEndpoint": "http://localhost:4317",
    "Attributes": [
      {
        "Key": "OS",
        "Value": "MacOs"
      }
    ]
  },
  "ExternalConfigurationOptions": {
    "Enabled" : true
  },
  "Spring": {
    "Cloud": {
      "Config": {
        "Name": "alternative", // name of the configuration you want to load
        "Uri": "http://localhost:8888", // url of the cloud config
        "FailFast": true,
        "Retry": {
          "Enabled": true
        },
        "Health": {
          "Enabled": false // true by default
          // A configuration is reloaded every time the health endpoint is checked
        },
        "PollingInterval": "00:00:30"
      }
    }
  }
}
