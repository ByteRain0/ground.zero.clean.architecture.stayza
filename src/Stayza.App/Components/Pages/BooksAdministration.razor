@page "/books-admin"
@using System.Diagnostics
@using System.Net.Http.Headers
@using System.Text.Json.Serialization
@using OpenTelemetry.Trace
@using Stayza.App.Infrastructure
@using Stayza.Application.Books.Commands
@using Stayza.Infrastructure.Persistence.DataSeed
@inject IHttpClientFactory Factory
@inject IConfiguration Configuration

<h3>Submit Form</h3>

@if (successMessage != null)
{
    <div class="alert alert-success">@successMessage</div>
}
@if (errorMessage != null)
{
    <div class="alert alert-danger">@errorMessage</div>
}


<form method="post" @onsubmit="SubmitAsync" @formname="bookCreate-form">
    <AntiforgeryToken/>
    <div>
        <label>
            ISBN:
            <InputText @bind-Value="Model!.ISBN"/>
        </label>
        <label>
            Name:
            <InputText @bind-Value="Model!.Title"/>
        </label>
        <label>
            Author:
            <InputText @bind-Value="Model!.Author"/>
        </label>
    </div>
    <div>
        <button type="submit">Submit</button>
    </div>
</form>


@code {
    private string successMessage;
    private string errorMessage;

    [SupplyParameterFromForm] public AddBookForm? Model { get; set; }

    protected override void OnInitialized() => Model ??= new();
    
    private async Task SubmitAsync()
    {
        try
        {
            var httpClient = Factory.CreateClient("ServerApi");
            
            httpClient.BaseAddress = new Uri(Configuration["BackEnd:Url"]!);
            httpClient.EnrichWithAppTraceData();
            
            var loginRequest = new LoginRequest
            {
                Email = TestUserSeeder.TestUser1Email,
                Password = TestUserSeeder.TestUser1Password
            };

            var response = await httpClient.PostAsJsonAsync("/login", loginRequest);

            if (!response.IsSuccessStatusCode)
            {
                throw new InvalidOperationException($"Login failed. ReasonPhrase: {response.ReasonPhrase}");
            }

            var loginData = await response.Content.ReadFromJsonAsync<LoginResponse>();

            httpClient.DefaultRequestHeaders.Authorization = null;
            httpClient.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", loginData!.AccessToken);
            
            var request = new AddBookCommand(
                Title: Model.Title,
                Author: Model.Author,
                ISBN: Model.ISBN);
            
            var bookResponse = await httpClient.PostAsJsonAsync("/api/v1/books", request);

            if (bookResponse.IsSuccessStatusCode)
            {
                successMessage = "Form submitted successfully!";
                errorMessage = null;
                Model = new AddBookForm(); // Reset the form
            }
            else
            {
                errorMessage = "There was an error submitting the form.";
                successMessage = null;
            }
        }
        catch (Exception ex)
        {
            Activity.Current?.RecordException(ex);
            errorMessage = $"An error occurred: {ex.Message}";
            successMessage = null;
        }
    }

    public class AddBookForm
    {
        public string Title { get; set; }
        
        public string ISBN { get; set; }

        public string Author { get; set; }
    }
    
    private class LoginRequest
    {
        public string Email { get; set; }

        public string Password { get; set; }
    }

    private class LoginResponse
    {
        [JsonPropertyName("accessToken")] public string AccessToken { get; set; }
    }
}