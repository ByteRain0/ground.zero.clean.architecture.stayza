{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Clusters": {
      "stayza-cluster": {
        "Destinations": {
          "stayza": {
            "Address": "http://stayza_api"
          }
        }
      },
      "notifications-cluster": {
        "Destinations": {
          "notifications_api": {
            "Address": "http://notifications_api"
          },
          "notifications_api_2": {
            "Address": "http://notifications_api"
          }
        },
        "LoadBalancingPolicy": "TenantBased"
      }
    },
    "Routes": {
      "greeting-route": {
        "RateLimiterPolicy": "fixedWindowPolicy",
        "ClusterId": "notifications-cluster",
        "Match": {
          "Path": "api/v1/hello"
        }
      },
      "loans-route": {
        "ClusterId": "stayza-cluster",
        "RateLimiterPolicy": "fixedWindowPolicy",
        "Match": {
          "Path": "api/v1/loans/{**catch-all}"
        }
      }
    }
  }
}